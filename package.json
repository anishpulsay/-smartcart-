{
  "name": "smart-cart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "ml": "python scovery-ml-camera/app.py",
    "pi": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_start.ps1",
    "scale": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_scale.ps1",
    "scale:calibrate": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_scale.ps1 -Calibrate",
    "scale:doctor": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_doctor.ps1",
    "scale:monitor": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_scale.ps1 -Monitor",
    "pi:all": "powershell -ExecutionPolicy Bypass -File scovery-ml-camera/remote_pi_all.ps1",
    "seed": "node server/seed.js",
    "start": "concurrently \"npm run dev\" \"npm run server\" \"npm run ml\"",
    "start:backend": "node server/index.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-qr-code": "^2.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "lowdb": "^7.0.1"
  }
}
